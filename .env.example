# 复制成 .env 后填值；.env 已被 .gitignore 忽略，绝不入库
# 数据库
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=inventory
MYSQL_APP_USER=inv_app
MYSQL_APP_PASSWORD=change_me_app
MYSQL_PORT=3306
# 应用侧连接串
DATABASE_URL=mysql+pymysql://inv_app:change_me_app@127.0.0.1:3306/inventory?charset=utf8mb4
# 数据生成参数（契约：对照实验前冻结并预注册）
GEN_SEED=20260924
GEN_SKU_LIMIT=200
GEN_START_DATE=2011-01-01
GEN_WEEKS=40

# LLM（三件都填才会走真实模型；留空则用确定性桩，便于离线跑测试）
# 任何 OpenAI 兼容的 /chat/completions 端点都可以，例如自建/第三方网关
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_CALL_BUDGET=50
LLM_BUDGET_CNY=20
LLM_PRICE_IN_CNY_PER_1M=2.0
LLM_PRICE_OUT_CNY_PER_1M=8.0
# 跑演示数据/回归测试时设为 1：即使配了 key 也走确定性桩，不花钱也不等十几秒
LLM_FORCE_STUB=0

# 计算与护栏参数（设定值，非行业实测；改这些要升 RULE_VERSION）
RULE_VERSION=v1
BASELINE_WINDOW_DAYS=28
REVIEW_PERIOD_DAYS=7
ORDER_COST=80
HOLDING_RATE=0.22
INVENTORY_CAP_MULTIPLIER=2.0
ANOMALY_ENTER_SCORE=3.0
ANOMALY_EXIT_SCORE=2.0
ANOMALY_CONFIRM_DAYS=2
ANOMALY_DAILY_QUOTA=20
APPROVER_AMOUNT_LIMIT=5000
